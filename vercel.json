{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "minigpt-backend": {
      "root": "backend",
      "framework": "fastapi",
      "buildCommand": "pip install -r requirements.txt"
    },
    "minigpt-frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm install && npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "minigpt-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "minigpt-frontend"
      }
    }
  ]
}
